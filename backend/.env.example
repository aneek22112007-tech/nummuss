# The current application uses deterministic seed signals; it does not call
# Alpaca, a news provider, or AWS Secrets Manager.
DDB_DECISIONS_TABLE=nummuss-decisions
DDB_SIGNALS_TABLE=nummuss-signals
DDB_SHADOW_TABLE=nummuss-shadow
S3_EVIDENCE_BUCKET=nummuss-evidence
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# CDK supplies these automatically in AWS. Set them only for a manual local test.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
REASON_DECIDE_FUNCTION_NAME=
AGENT_ROLE=disciplined
MODE=live_paper
POSITION_CAP_PCT=5
DAILY_LOSS_CAP_USD=200
DAILY_LOSS_CAP_INR=20000
COOLDOWN_LOSSES=2
COOLDOWN_CYCLES=4
MIN_EVIDENCE_TIER=medium
BASE_SIZE_USD=1000
REPLAY_START_CAPITAL_INR=100000
