# Nummuss Frontend — Environment Variables
#
# Set this to your deployed API Gateway URL (no trailing slash).
# Leave empty (or remove the file) to run in fully offline/mock-data mode.
#
# Example:
#   VITE_API_BASE_URL=https://abc123xyz.execute-api.ap-south-1.amazonaws.com/prod

VITE_API_BASE_URL=

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# Steps:
# 1. Go to Google Cloud Console
# 2. Create/Select a project
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized JavaScript origins: http://localhost:5173
# 6. Add authorized redirect URIs: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
